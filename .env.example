# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# API Configuration
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=info

# DEV.to Destination Connector
DEVTO_API_KEY=
DEVTO_BASE_URL=https://dev.to/api

# Ghost CMS Destination Connector
GHOST_ADMIN_API_KEY=
GHOST_API_URL=http://localhost:2368

# Discourse Destination Connector
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
DISCOURSE_BASE_URL=http://localhost:4200

# Lemmy Destination Connector
LEMMY_AUTH_TOKEN=
LEMMY_INSTANCE_URL=http://localhost:8536
LEMMY_COMMUNITY_ID=

# Generic HMAC Webhook Connector
WEBHOOK_URL=
WEBHOOK_SECRET=

# Assisted Manual Packaging
ASSISTED_OUTPUT_DIR=./artifacts/assisted_packs

# Connector Certification Output
CERTIFICATION_OUTPUT_DIR=./artifacts/certification

